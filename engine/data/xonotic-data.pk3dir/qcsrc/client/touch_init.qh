#pragma once

void Touch_Init(void);

// One table of touch settings and their defaults, walked in three modes — see
// touch_init.qc. The mode is private to that file; these are the three doors in.
void Touch_DefineCvars(void);
void Touch_ResetDefaults(void);
void Touch_WriteAllCvars(float fh);

// Bump when a default changes in a way that a previously saved layout would
// wrongly override.
//   2 = two-thumb redesign (new baseline, chrome pills, chat button, mobile HUD)
//   3 = top band split into thirds; CONSOLE moved to the bottom-left corner
//   4 = ammo folded into the vitals group; its own anchor cvars retired
const float TOUCH_LAYOUT_VERSION = 4;
void Touch_MigrateLayout(void);

void Touch_EnforceSquare2D(void);
void Touch_LoadStartupConfigs(void);
void Touch_ApplySensitivity(void);
void Touch_ApplyTouchWeaponsStrip(void);
void Touch_ApplyMobileHudEngineSettings(void);
void Touch_ApplyChatFeedSettings(void);
void Touch_ApplyTimerPanel(void);
void Touch_ApplyNotifyPanel(void);

