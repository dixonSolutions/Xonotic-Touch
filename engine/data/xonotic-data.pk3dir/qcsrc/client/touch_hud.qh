#pragma once

// Vitals readouts. Deliberately no hit test: these are readouts, not controls,
// and blocking input over them put a dead patch in the aim area.

bool Touch_Hud_ShouldDraw(void);
void Touch_Hud_Draw(float alpha);

// The weapons strip's resize grip, driven by a finger in TOUCH_ROLE_WEPSIZE.
void Touch_Hud_GripBegin(vector p);
void Touch_Hud_GripMove(vector p);
void Touch_Hud_GripEnd(void);
