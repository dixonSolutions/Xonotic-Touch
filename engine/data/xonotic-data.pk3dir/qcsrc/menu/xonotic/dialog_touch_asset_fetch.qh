#pragma once

#include "rootdialog.qh"
#include "touch_startup_util.qh"

// First-launch setup wizard: the package ships boot assets only, so this dialog
// owns the screen until the game data it is downloading is usable.
CLASS(GodnoticAssetFetchDialog, XonoticRootDialog)
	METHOD(GodnoticAssetFetchDialog, fill, void(entity));
	METHOD(GodnoticAssetFetchDialog, shouldShow, bool());
	METHOD(GodnoticAssetFetchDialog, draw, void(entity));
	// Title chrome stays empty — the Xonotic logo is the brand signal.
	ATTRIB(GodnoticAssetFetchDialog, title, string, "");
	ATTRIB(GodnoticAssetFetchDialog, color, vector, '0.06 0.07 0.1');
	// Edge-to-edge setup screen — the broken main menu must never show through.
	ATTRIB(GodnoticAssetFetchDialog, intendedWidth, float, 1);
	// Hero logo + one large primary action (background / close / retry).
	ATTRIB(GodnoticAssetFetchDialog, rows, float, 20);
	ATTRIB(GodnoticAssetFetchDialog, columns, float, 6);
	ATTRIB(GodnoticAssetFetchDialog, name, string, "TouchAssetFetch");
	ATTRIB(GodnoticAssetFetchDialog, closable, bool, false);
	// Progress file mirror; all three are owned by strcpy (never a constant).
	ATTRIB(GodnoticAssetFetchDialog, progressStatus, string, string_null);
	ATTRIB(GodnoticAssetFetchDialog, progressPercent, float, 0);
	ATTRIB(GodnoticAssetFetchDialog, progressMessage, string, string_null);
	ATTRIB(GodnoticAssetFetchDialog, logoImage, entity);
	ATTRIB(GodnoticAssetFetchDialog, headlineLabel, entity);
	ATTRIB(GodnoticAssetFetchDialog, statusLabel, entity);
	ATTRIB(GodnoticAssetFetchDialog, hintLabel, entity);
	ATTRIB(GodnoticAssetFetchDialog, percentLabel, entity);
	ATTRIB(GodnoticAssetFetchDialog, progressBar, entity);
	// One always-focusable CTA — never stack invisible disabled siblings (they
	// still win itemFromPoint and swallow taps on touchscreens).
	ATTRIB(GodnoticAssetFetchDialog, primaryButton, entity);
	// Set once the download reported success, to hold the finished state on
	// screen for a beat before the relaunch takes the window away.
	ATTRIB(GodnoticAssetFetchDialog, completedTime, float, 0);
	// "Try again" could not hand back to the launcher, so the user has to
	// restart the app by hand.
	ATTRIB(GodnoticAssetFetchDialog, relaunchFailed, bool, false);
	// Menu BGM starts once the music pack is on disk (may be mid-download).
	ATTRIB(GodnoticAssetFetchDialog, musicStarted, bool, false);
	ATTRIB(GodnoticAssetFetchDialog, backgroundFailed, bool, false);
	// User chose background download — UI stays until they close the window.
	ATTRIB(GodnoticAssetFetchDialog, backgroundMode, bool, false);
	// Earliest time Close window may quit (blocks same-gesture double-fire).
	ATTRIB(GodnoticAssetFetchDialog, backgroundCloseArmedTime, float, 0);
ENDCLASS(GodnoticAssetFetchDialog)
