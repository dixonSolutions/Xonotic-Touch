#pragma once

// Godnotic: one size for the whole menu on a touch device, from the screen's
// density, instead of per-dialog tweaks.
//
// The stock menu lays every dialog out in "virtual" units: a 12-unit font, a
// 17.4-unit row, and a layout height equal to vid_conheight. On a phone that
// made a row about 15 dp and the text about 10 sp.
//
// On a touch device this layer:
//  - picks the layout height so one virtual unit is TOUCH_MENU_DP_PER_UNIT dp
//    (times menu_touch_size) and draws that layout over the real console size;
//  - makes every dialog row TOUCH_MENU_ROW_DP tall with TOUCH_MENU_GAP_DP
//    between rows (the skin's row height and margins, before any dialog is
//    built), so every control the stock dialogs put in a row is a finger
//    target;
//  - keeps the layout clear of the display cutouts and of the engine's
//    console button (_touch_safe_insets, touch_shell_button_size).
// Dialogs that no longer fit the screen height scroll (touch_menu_sheet.qc)
// instead of being squeezed, so there is no minimum layout height any more.
// Desktop (no touch screen) is untouched unless menu_touch_size forces it.

// dp per virtual unit at menu_touch_size 1: the 12-unit body font is then
// 19 sp, the 16-unit title 26 sp.
const float TOUCH_MENU_DP_PER_UNIT = 1.6;
// Every dialog row (button, checkbox, slider, input box, tab) and the gap
// between rows, in dp, before menu_touch_size.
const float TOUCH_MENU_ROW_DP = 48;
const float TOUCH_MENU_GAP_DP = 8;
// List rows (server list, maps, demos, mods) are at least this tall, in dp.
const float TOUCH_MENU_LISTROW_DP = 48;
// Widest layout aspect on a touch device: a 20:9 phone uses its full width.
const float TOUCH_MENU_MAX_ASPECT = 2.4;

// Console units per layout unit; 1 = stock. Fixed once the menu has been
// built, so the dialogs keep the proportions they were laid out with.
float touch_menu_scale;
bool touch_menu_scale_fixed;
// Latched when the skin is applied: the touch layer is on for this menu
// instance (the launcher, sheets and row sizes all follow it).
bool touch_menu_on;
// dp per layout unit for this menu instance.
float touch_menu_unit_dp;
// Layout area kept clear on the left and right, in console units.
float touch_menu_reserve_l, touch_menu_reserve_r;

bool TouchMenuScale_active();
// Called by UpdateConWidthHeight (menu.qc) after it set conwidth/conheight.
void TouchMenuScale_layout();
// Called first thing by draw_reset_cropped (menu.qc); true when it did the reset.
bool TouchMenuScale_drawReset();
// Called by m_init_delayed (menu.qc) after the skin values are read.
void TouchMenuScale_applySkin();
// Device density in dpi as the layer sees it, and the dp size of a length in
// console units (for the settings readout and the screenshots audit).
float TouchMenuScale_dpi();
float TouchMenuScale_conToDp(float conunits);
// Layout units for a length in dp.
float TouchMenuScale_dpToUnits(float dp);
float TouchMenuScale_size();
// XonoticListBox_resizeNotify: an item height (relative to the list) at least
// TOUCH_MENU_LISTROW_DP tall.
float TouchMenuScale_listItemHeight(float itemHeight, vector absSize);
