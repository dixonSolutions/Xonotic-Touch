#pragma once

// Godnotic: the main menu on a touch device.
//
// The stock main menu is a "nexposee": live, shrunken copies of every dialog
// to tap into. On a phone those copies are unreadable and the bottom row
// (Credits, Quit) ran off the screen. On a touch device the main window shows
// this launcher instead: the GODNOTIC banner (the menu background) on top,
// big tiles under it, and each tile opens the same stock dialog as a sheet
// over it (touch_menu_sheet.qc). Closing a sheet comes back here; Android's
// Back closes the top sheet (K_ESCAPE, Dialog_keyDown).
#include "dialog.qh"
CLASS(GodnoticLauncherDialog, XonoticDialog)
	METHOD(GodnoticLauncherDialog, fill, void(entity));
	ATTRIB(GodnoticLauncherDialog, title, string, "");
	ATTRIB(GodnoticLauncherDialog, titleFontSize, float, 0);
	ATTRIB(GodnoticLauncherDialog, closable, bool, false);
	ATTRIB(GodnoticLauncherDialog, backgroundImage, string, string_null);
	ATTRIB(GodnoticLauncherDialog, color, vector, SKINCOLOR_DIALOG_SETTINGS);
	ATTRIB(GodnoticLauncherDialog, intendedWidth, float, 1);
	ATTRIB(GodnoticLauncherDialog, rows, float, 5);
	ATTRIB(GodnoticLauncherDialog, columns, float, 6);
	ATTRIB(GodnoticLauncherDialog, name, string, "TouchLauncher");
	ATTRIB(GodnoticLauncherDialog, singleplayerDialog, entity);
	ATTRIB(GodnoticLauncherDialog, multiplayerDialog, entity);
	ATTRIB(GodnoticLauncherDialog, mediaDialog, entity);
	ATTRIB(GodnoticLauncherDialog, settingsDialog, entity);
	ATTRIB(GodnoticLauncherDialog, creditsDialog, entity);
	ATTRIB(GodnoticLauncherDialog, quitDialog, entity);
ENDCLASS(GodnoticLauncherDialog)

entity touch_launcher;

// MainWindow_configureMainWindow: on a touch device, build the main dialogs
// as sheets of the main window with the launcher in front, instead of the
// nexposee. False (and nothing done) on a desktop.
bool TouchLauncher_Configure(entity mainwindow);
// Every frame (touch_menu_sheet.qc): out of a match the launcher is always
// behind whatever sheet is open, so closing the last sheet lands on it.
void TouchLauncher_heal();
