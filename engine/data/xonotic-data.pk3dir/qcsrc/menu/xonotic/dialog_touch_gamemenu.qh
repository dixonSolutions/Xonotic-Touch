#pragma once

// The game menu on a touchscreen: what Escape, Android Back and the MENU pill
// open while connected (TouchGameMenu_Route). The stock GameMenu's rows are a
// thumb's width apart on a tablet; this one has finger-sized buttons: Resume
// and Join game / Spectate first, Leave and Quit on the pinned bottom row.
#include "rootdialog.qh"
CLASS(GodnoticGameMenuDialog, XonoticRootDialog)
	METHOD(GodnoticGameMenuDialog, fill, void(entity));
	METHOD(GodnoticGameMenuDialog, configureDialog, void(entity));
	ATTRIB(GodnoticGameMenuDialog, title, string, _("Game menu"));
	ATTRIB(GodnoticGameMenuDialog, color, vector, SKINCOLOR_DIALOG_QUIT);
	ATTRIB(GodnoticGameMenuDialog, intendedWidth, float, 0.56);
	ATTRIB(GodnoticGameMenuDialog, rows, float, 14);
	ATTRIB(GodnoticGameMenuDialog, columns, float, 2);
	ATTRIB(GodnoticGameMenuDialog, name, string, "TouchGameMenu");
	ATTRIB(GodnoticGameMenuDialog, requiresConnection, bool, true);
ENDCLASS(GodnoticGameMenuDialog)

// m_goto's dialog name, swapped for TouchGameMenu on a touchscreen.
string TouchGameMenu_Route(string itemname);
// Called when a dialog closes: one opened from TouchGameMenu goes back to it
// while still connected, instead of to the main menu overview. True if it did.
bool TouchGameMenu_Return(entity dialog);
// The connection dropped (timeout, kick, server gone): the game menu, which
// needs one, closes, so show the main menu overview rather than nothing.
void TouchGameMenu_Disconnected();
