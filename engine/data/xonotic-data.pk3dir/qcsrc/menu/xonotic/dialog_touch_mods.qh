#pragma once

// The manager for Lua client mods (<userdir>/mods) and server plugins
// (<userdir>/plugins), docs/PLUGIN_STANDARD.md: a sheet of its own
// ("touchmods"), opened by the launcher's Mods tile and by the button on
// Settings -> Mobile -> Mods, so its pages get the whole screen rather than
// the room under four rows of tabs.
//
// One sheet with these views: the list (client mods or server plugins), a mod's
// details (permissions with the author's reasons and a switch each, settings,
// recent output, events/hooks/commands), Install (a link or a file), the
// review shown before anything is installed, the confirmation before an
// uninstall, and a page with the whole of a text too long for its row (tap
// a text that ends in "..."). Rows are finger-sized; everything works with
// a mouse too.
//
// The tab never changes anything itself: every action is the console command
// the engine checks (lua_mod_enable, lua_mod_permission, lua_mod_install,
// lua_install_confirm, lua_mod_uninstall and the sv_lua_plugin_* twins), so a
// change made in the console shows up here and the other way round. What it
// shows comes from read-only cvars the engine keeps current:
//   _cl_lua_mods / _sv_lua_plugins  name<TAB>state<TAB>title<TAB>error<TAB>description per line
//   _lua_detail                     the mod _lua_select names ("mod x" / "plugin x"): key<TAB>value lines
//   _lua_install                    the pending install: state, manifest, permissions
//   _lua_last                       the manager's last message
//
// Android: "Pick a file" asks the platform layer (ModImport.java) through the
// file handshake of touch_update_util.qh: the menu writes
// touch/mod-import-request.txt; ModImport copies the picked .zip to
// <userdir>/luastate/incoming/ and writes "picked <time> <path>" to
// touch/mod-import-status.txt; the menu then runs lua_mod_install on it, so the
// engine checks and reviews it like any other package. The button only shows
// where that status file exists.

#include "rootdialog.qh"
#include "tab.qh"
#include "textlabel.qh"
#include "touchbutton.qh"
#include "inputbox.qh"

CLASS(GodnoticModsDialog, XonoticRootDialog)
	METHOD(GodnoticModsDialog, fill, void(entity));
	ATTRIB(GodnoticModsDialog, title, string, _("Mods and plugins"));
	ATTRIB(GodnoticModsDialog, color, vector, SKINCOLOR_DIALOG_SETTINGS);
	ATTRIB(GodnoticModsDialog, intendedWidth, float, 0.96);
	ATTRIB(GodnoticModsDialog, rows, float, 14);
	ATTRIB(GodnoticModsDialog, columns, float, 6);
	ATTRIB(GodnoticModsDialog, name, string, "touchmods");
ENDCLASS(GodnoticModsDialog)
entity godnotic_mods_dialog;
// mainwindow.qc: add the manager's sheet.
void TouchMods_ConfigureDialogs(entity mainwindow);

// Settings -> Mobile -> Mods: what the manager is, and a button to open it.
CLASS(GodnoticModsTab, XonoticTab)
	METHOD(GodnoticModsTab, fill, void(entity));
	ATTRIB(GodnoticModsTab, intendedWidth, float, 0.9);
	ATTRIB(GodnoticModsTab, rows, float, 14);
	ATTRIB(GodnoticModsTab, columns, float, 6);
	ATTRIB(GodnoticModsTab, name, string, "touchmodstab");
ENDCLASS(GodnoticModsTab)
entity makeGodnoticModsTab();

// A finger-sized button whose text and action follow one slot of the
// current view (or a page / bar action).
CLASS(GodnoticModsButton, GodnoticButton)
	METHOD(GodnoticModsButton, draw, void(entity));
	ATTRIB(GodnoticModsButton, modSlot, int, 0);
	ATTRIB(GodnoticModsButton, modRole, int, 0);
	ATTRIB(GodnoticModsButton, modText, string);
ENDCLASS(GodnoticModsButton)

// A text of the current view. One too long for its box wraps onto a second
// line, and past that ends in "..." and opens the whole of it when tapped.
CLASS(GodnoticModsLabel, XonoticTextLabel)
	METHOD(GodnoticModsLabel, draw, void(entity));
	METHOD(GodnoticModsLabel, mousePress, bool(entity, vector));
	METHOD(GodnoticModsLabel, mouseRelease, float(entity, vector));
	ATTRIB(GodnoticModsLabel, modCut, bool, false);
	ATTRIB(GodnoticModsLabel, modPressed, bool, false);
	ATTRIB(GodnoticModsLabel, modSlot, int, 0);
	ATTRIB(GodnoticModsLabel, modRole, int, 0);
	ATTRIB(GodnoticModsLabel, modText, string);
	ATTRIB(GodnoticModsLabel, allowColors, bool, true);
	ATTRIB(GodnoticModsLabel, allowCut, bool, true);
ENDCLASS(GodnoticModsLabel)

// The link / path field of the Install view (hidden in the other views)
CLASS(GodnoticModsInput, XonoticInputBox)
	METHOD(GodnoticModsInput, draw, void(entity));
	METHOD(GodnoticModsInput, mousePress, bool(entity, vector));
	METHOD(GodnoticModsInput, keyDown, float(entity, float, float, float));
ENDCLASS(GodnoticModsInput)

const string TOUCH_MODS_IMPORT_REQUEST_FILE = "touch/mod-import-request.txt";
const string TOUCH_MODS_IMPORT_STATUS_FILE = "touch/mod-import-status.txt";
