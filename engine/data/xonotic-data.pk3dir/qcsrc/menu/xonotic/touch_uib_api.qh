#pragma once

// Godnotic UI bridge: engine builtins (engine/darkplaces/touch_uib_mvm.c), protocol
// docs/UI_BRIDGE.md. Call nothing here unless UIB_EngineHasBridge(): a newer menu.dat
// on an older engine must not call a builtin that is not there.

float uib_begin(string rootid, string type) = #1180;
float uib_node(string key, string type) = #1181;
void uib_end() = #1182;
void uib_done() = #1183;
void uib_s(string key, string value) = #1184;
void uib_f(string key, float value) = #1185;
void uib_b(string key, float value) = #1186;
void uib_j(string key, string json) = #1187;
void uib_push(string key, string json) = #1188;
string uib_q(string s) = #1189;
void uib_nav(string stack, string modal, float canback, string context) = #1190;
void uib_busy(string json) = #1191;
void uib_toast(string text, string kind, string icon, float timeout) = #1192;
void uib_remove(string id) = #1193;
void uib_rows_begin(string source) = #1194;
void uib_row(string key, string cellsjson, string image) = #1195;
void uib_rows_end() = #1196;
void uib_param(string source, string key, string value) = #1197;
float uib_native() = #1198;
void uib_reset() = #1199;
float uib_rev() = #1200;
float uib_count(string id) = #1201;
string uib_child(string id, float i) = #1202;
string uib_type(string id) = #1203;
string uib_get(string id, string path) = #1204;
float uib_has(string id, string path) = #1205;
float uib_window(string source, float offset, float limit, string sort, float desc, string filter) = #1206;
float uib_wtotal() = #1207;
string uib_wkey(float i) = #1208;
string uib_wimage(float i) = #1209;
string uib_wcell(float i, string key) = #1210;
string uib_imgpath(string ref) = #1211;
float uib_srcrev(string source) = #1212;
string uib_modpages() = #1213;
string uib_caps(string path) = #1214;
void uib_tick(float on) = #1215;
float uib_nodegen(string id) = #1216;
string uib_origin(string id) = #1217;
void uib_event(string json) = #1218;
string uib_qv(string s) = #1219;
string uib_parent(string id) = #1220;
string uib_loadinfo() = #1221;
string uib_thumb(string ref, float w, float h) = #1222;

bool UIB_EngineHasBridge() { return cvar_string("uib_version") != ""; }
float uib_gettime(float which) = #67;  // gettime with its mode argument (1: real time now)
