#pragma once

#include "button.qh"
#include "commandbutton.qh"

CLASS(GodnoticButton, XonoticButton)
	ATTRIB(GodnoticButton, fontSize, float, SKINFONTSIZE_NORMAL * 1.35);
	ATTRIB(GodnoticButton, image, string, SKINGFX_BUTTON_BIG);
	ATTRIB(GodnoticButton, grayImage, string, SKINGFX_BUTTON_BIG_GRAY);
ENDCLASS(GodnoticButton)

CLASS(GodnoticCommandButton, XonoticCommandButton)
	ATTRIB(GodnoticCommandButton, fontSize, float, SKINFONTSIZE_NORMAL * 1.35);
	ATTRIB(GodnoticCommandButton, image, string, SKINGFX_BUTTON_BIG);
	ATTRIB(GodnoticCommandButton, grayImage, string, SKINGFX_BUTTON_BIG_GRAY);
ENDCLASS(GodnoticCommandButton)

entity makeGodnoticButton(string theText, vector theColor);
entity makeGodnoticCommandButton(string theText, vector theColor, string theCommand, int theFlags);
