# Build outputs — never commit
build/
build-flatpak/
build-clickable/
.clickable/
bin/
click/.ci-version
click/.ci-name
click/.ci-framework
site/
combined-repo/
docs/test-runs/**/screenshots/
# Scratch captures from scripts/dev-shot.sh. Anything worth keeping is copied
# into the dated run folder alongside the findings that cite it.
docs/test-runs/current/
docs/test-runs/**/*.tga
docs/test-runs/**/*.log

# Engine compile artifacts only (full Xonotic tree under engine/ is tracked)
engine/darkplaces/build-obj/
engine/darkplaces/darkplaces-sdl
engine/darkplaces/darkplaces-sdl-release
engine/darkplaces/darkplaces-sdl-debug
engine/darkplaces/darkplaces-sdl-profile
engine/gmqcc/gmqcc
engine/d0_blind_id/.libs/
engine/**/build-obj/
engine/**/*.o
engine/**/*.a
engine/**/.libs/

# Nested upstream git metadata (strip with scripts/prepare-engine-for-git.sh)
engine/**/.git/

# QuakeC / packaging outputs (regenerated at build)
engine/data/xonotic-data.pk3dir/progs/
engine/data/xonotic-data.pk3dir/*.pk3
engine/data/xonotic-data.pk3dir/.tmp/

# Large game assets (~3 GB — fetch with scripts/fetch-sources.sh assets)
engine/data/xonotic-data.pk3dir/textures/
engine/data/xonotic-data.pk3dir/models/
engine/data/xonotic-data.pk3dir/sound/
engine/data/xonotic-data.pk3dir/maps/
engine/data/xonotic-data.pk3dir/gfx/
engine/data/xonotic-data.pk3dir/particles/
engine/data/xonotic-data.pk3dir/demos/
engine/data/xonotic-data.pk3dir/cubemaps/

engine/data/xonotic-maps.pk3dir/
engine/data/xonotic-music.pk3dir/
engine/data/xonotic-nexcompat.pk3dir/
engine/data/screen.layout.cfg
engine/data/touch/

# Runtime data copies at repo root
data/*
!data/README.md

# Python
__pycache__/
*.py[cod]

# Android build inputs generated by scripts/android-build.sh
android/.gradle/
android/app/build/
android/app/src/main/assets/xonotic-slim-data.zip
android/app/src/main/java/org/libsdl/
android/app/src/main/jniLibs/
android/app/src/main/res/mipmap-*/
android/local.properties
