[Desktop Entry]
Name=Godnotic
Exec=godnotic-loader %u
Icon=io.github.dixonSolutions.XonoticTouch
Terminal=false
Type=Application
Categories=Game;ActionGame;
StartupWMClass=io.github.dixonSolutions.XonoticTouch
MimeType=x-scheme-handler/godnotic;
Actions=play;

[Desktop Action play]
Name=Play directly
Exec=start.sh
