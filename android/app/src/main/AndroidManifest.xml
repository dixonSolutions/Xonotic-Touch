<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- Only the bundled slim data ships in the APK; maps, textures and music
         are pulled from the Xonotic autobuild server on first launch. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- KeepAliveService: keeps a server connection, a join and the game data
         download going while the app is in the background, only while one of
         them is. Without it Android freezes the process within seconds; its
         wake lock keeps the CPU running with the screen off meanwhile. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- xt.vibrate for client mods (SDL haptic over the device vibrator; a normal permission, no prompt) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- LanLocks: while this device hosts a LAN game, a multicast lock lets
         the Wi-Fi driver pass the other players' broadcast search through
         (many phones drop broadcasts without one). Granted at install. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Sideloaded builds have no store to update them, so the app offers its
         own release feed on launch. Android still confirms every install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: once this app has installed one of its own updates it is
         the installer of record, and later updates can skip the confirm
         dialog. Without the permission setRequireUserAction is ignored. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:name=".NativeUIApplication"
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:icon="@mipmap/icon"
        android:roundIcon="@mipmap/icon"
        android:label="@string/app_name"
        android:hardwareAccelerated="true"
        android:appCategory="game"
        android:isGame="true"
        android:extractNativeLibs="true">

        <activity
            android:name=".GodnoticBootActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.XonoticBoot">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Hand-over from the web game (web/shell.js): a godnotic: link
                 or an intent URL naming this package opens the app, which
                 has the game data and the settings. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="godnotic" />
            </intent-filter>
            <!-- App Link: a link to the web game opens the app instead, once
                 Android has verified https://godnotic.vercel.app/.well-known/assetlinks.json
                 (web/.well-known/assetlinks.json: this package and its signing
                 certificate). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="godnotic.vercel.app" android:path="/" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BootActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.XonoticBoot" />

        <activity
            android:name=".XonoticActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:screenOrientation="sensorLandscape"
            android:preferMinimalPostProcessing="true"
            android:theme="@style/Theme.XonoticGame"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation" />

        <!-- The web game asks Chrome whether this app is installed
             (navigator.getInstalledRelatedApps); Chrome answers only for
             sites the app names here. -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <!-- The game data, read only, in the system file picker ("Godnotic"),
             so the web game can take the packs this app downloaded instead of
             downloading them again (GameDataProvider, docs/WEB.md). Only the
             system's document UI may query it. -->
        <provider
            android:name=".GameDataProvider"
            android:authorities="${applicationId}.gamedata"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the player's connection to a multiplayer game server open while the game is in the background, so returning to the app does not drop them from the match." />
        </service>

        <!-- DataService: the rest of the split data set (the other maps, the
             music) downloads behind the running game and carries on while
             the app is in the background (docs/DATA_FETCH.md). -->
        <service
            android:name=".DataService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
