<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:id="@+id/boot_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#F2F4F8"
        android:textSize="18sp"
        android:text="@string/boot_unpacking" />

    <TextView
        android:id="@+id/boot_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#8C93A3"
        android:textSize="14sp"
        android:text="@string/boot_first_run" />

    <ProgressBar
        android:id="@+id/boot_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:max="100" />

    <Button
        android:id="@+id/boot_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:visibility="gone"
        android:text="@string/boot_retry" />
</LinearLayout>
