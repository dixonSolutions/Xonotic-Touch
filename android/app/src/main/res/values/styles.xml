<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Xonotic's own dark chrome, so the boot screen does not flash white
         before the engine takes over the surface. -->
    <style name="Theme.XonoticBoot" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#12141A</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
